---
// Diseño de la portada, fuera de Starlight.
//
// - Estilos: las fuentes, el reset de Astryx con su tema neutral, y encima los tokens del sitio (tokens.css) con el
//   puente que los asigna a Astryx (astryx-puente.css). sitio.css compone la página con los tokens de Astryx
//   (tamaños de texto, radios, duraciones) y los colores del sitio. Un solo tema, claro, como la documentación.
// - JavaScript: solo el script en línea de los botones «Copiar» (components/producto/Codigo.astro).
import '../styles/fuentes.css';
import '@astryxdesign/core/reset.css';
import '@astryxdesign/theme-neutral/theme.css';
import '../styles/tokens.css';
import '../styles/tema.css';
import '../styles/astryx-puente.css';
import '../styles/sitio.css';
import Cabecera from '../components/producto/Cabecera.astro';
import PieSitio from '../components/producto/PieSitio.astro';
import { BASE, META_SOCIAL, SITIO_URL } from '../../sitio.config.mjs';

interface Props {
  /** Título de la pestaña, sin « | factura-hn» (la portada lo lleva completo). */
  titulo: string;
  descripcion: string;
  /** Ruta sin la base, con barras: '/'. */
  ruta: string;
}
const { titulo, descripcion, ruta } = Astro.props;
const tituloCompleto = ruta === '/' ? titulo : `${titulo} | factura-hn`;
const canonica = `${SITIO_URL}${BASE}${ruta}`;
---

<!doctype html>
<html lang="es" dir="ltr" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
		<link rel="alternate" type="text/markdown" href={`${BASE}${ruta === '/' ? '/index' : ruta.replace(/\/$/, '')}.md`} />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonica} />
		{META_SOCIAL.map((attrs) => <meta {...attrs} />)}
		<link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
	</head>
	<body data-astryx-theme="neutral">
		<a class="saltar" href="#contenido">Ir al contenido</a>
		<Cabecera />
		<main id="contenido">
			<slot />
		</main>
		<PieSitio />
		<p class="sr-only" role="status" aria-live="polite" data-aviso-copiado></p>
		<script is:inline>
			(() => {
				const aviso = document.querySelector('[data-aviso-copiado]');
				document.addEventListener('click', async (e) => {
					const boton = e.target instanceof Element && e.target.closest('[data-copiar]');
					if (!boton) return;
					const codigo = boton.closest('[data-codigo]')?.querySelector('pre');
					if (!codigo) return;
					const contenido = codigo.innerText.replace(/\n+$/, '');
					let copiado = false;
					try {
						await navigator.clipboard.writeText(contenido);
						copiado = true;
					} catch {
						// Sin permiso para el portapapeles (o sin HTTPS): el método de siempre, con un campo temporal.
						const campo = document.createElement('textarea');
						campo.value = contenido;
						campo.setAttribute('readonly', '');
						campo.style.cssText = 'position:fixed;opacity:0';
						document.body.append(campo);
						campo.select();
						try {
							copiado = document.execCommand('copy');
						} catch {}
						campo.remove();
						boton.focus();
					}
					const texto = copiado ? 'Copiado' : 'No se pudo copiar: selecciona el texto y cópialo a mano.';
					boton.textContent = copiado ? 'Copiado' : 'Copiar';
					aviso.textContent = '';
					setTimeout(() => (aviso.textContent = texto), 50);
					clearTimeout(boton._t);
					boton._t = setTimeout(() => (boton.textContent = 'Copiar'), 2000);
				});
			})();
		</script>
	</body>
</html>
