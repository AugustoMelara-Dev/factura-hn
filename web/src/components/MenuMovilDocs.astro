---
// Pie del menú del teléfono en la documentación (reemplaza al MobileMenuFooter de Starlight): la portada y
// GitHub, que en pantallas angostas no caben en la cabecera, y después lo de Starlight (redes).
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { conBase } from '../datos/navegacion';
---

<nav class="producto" aria-label="factura-hn">
	<a href={conBase('/')}>Portada</a>
</nav>
<Default />

<style>
	.producto {
		display: flex;
		padding-block: 0.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.producto a {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-weight: 500;
	}
	.producto a:hover {
		color: var(--sl-color-white);
	}
</style>
