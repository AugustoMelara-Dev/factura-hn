---
// Cabecera de la documentación (reemplaza a la de Starlight): la marca, el buscador y la navegación principal del
// sitio (la misma de la portada: Documentación y GitHub). En el teléfono, la navegación va en el menú
// (MenuMovilDocs.astro y los iconos de Starlight).
import Search from '@astrojs/starlight/components/Search.astro';
import Marca from './Marca.astro';
import { conBase, NAV } from '../datos/navegacion';
---

<div class="cabecera">
	<div class="titulo sl-flex"><Marca class="site-title" /></div>
	<div class="sl-flex print:hidden buscador"><Search /></div>
	<nav class="nav-principal print:hidden" aria-label="Principal">
		{
			NAV.map((e) =>
				e.externo ? (
					<a href={e.ruta} rel="noopener">
						{e.texto}
					</a>
				) : (
					<a href={conBase(e.ruta)} aria-current="page">
						{e.texto}
					</a>
				),
			)
		}
	</nav>
</div>

<style>
	.cabecera {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}
	.titulo {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	.nav-principal {
		display: none;
	}
	@media (min-width: 50rem) {
		.cabecera {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			column-gap: 2rem;
		}
		.buscador {
			justify-content: center;
		}
		.nav-principal {
			display: flex;
			gap: 1.75rem;
			font-size: var(--sl-text-sm);
		}
		.nav-principal a {
			display: inline-flex;
			align-items: center;
			min-height: 2.75rem;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			font-weight: 500;
		}
		.nav-principal a:hover,
		.nav-principal a[aria-current='page'] {
			color: var(--sl-color-white);
		}
	}
</style>
