---
// La marca del sitio: el ícono de documento en el color de acento y «factura-hn» en monoespaciada. La misma en la
// cabecera de las páginas del producto, en la de la documentación (reemplaza al SiteTitle de Starlight) y en el
// pie. El ícono es el mismo de public/favicon.svg.
import { conBase } from '../datos/navegacion';

interface Props {
  /** Clase extra, por ejemplo `site-title` en la documentación. */
  class?: string;
}
const { class: clase } = Astro.props;
---

<a class:list={['marca', clase]} href={conBase('/')} aria-label="factura-hn, inicio">
	<svg class="marca-icono" viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
		<rect x="3" y="2" width="18" height="20" rx="3" fill="currentColor"></rect>
		<path d="M7.5 8h9M7.5 12h9M7.5 16h5" stroke="var(--fhn-fondo)" stroke-width="1.8" stroke-linecap="round"></path>
	</svg>
	<span>factura-hn</span>
</a>

<style>
	.marca {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		color: var(--fhn-texto);
		font-family: var(--fhn-fuente-mono);
		font-weight: 600;
		font-size: 1.0625rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.marca:hover {
		color: var(--fhn-texto);
	}
	.marca-icono {
		color: var(--fhn-acento);
		flex: none;
	}
</style>
