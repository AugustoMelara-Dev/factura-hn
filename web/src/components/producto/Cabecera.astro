---
// Cabecera de la portada: la marca y la navegación principal (Docs y GitHub), la misma de la
// documentación. Son dos enlaces: caben también en el teléfono, sin menú.
import Marca from '../Marca.astro';
import { conBase, NAV } from '../../datos/navegacion';
---

<header class="cab">
	<div class="contenedor cab-fila">
		<Marca />
		<nav class="cab-nav" aria-label="Principal">
			{
				NAV.map((e) =>
					e.externo ? (
						<a href={e.ruta} rel="noopener">
							{e.texto}
						</a>
					) : (
						<a href={conBase(e.ruta)}>{e.texto}</a>
					),
				)
			}
		</nav>
	</div>
</header>
