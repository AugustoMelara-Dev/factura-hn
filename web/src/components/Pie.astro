---
// Pie de cada página de la documentación: la paginación de Starlight y la misma línea del pie de la portada.
import Default from '@astrojs/starlight/components/Footer.astro';
import LineaPie from './LineaPie.astro';
---

<Default><slot /></Default>
<div class="fhn-pie">
  <LineaPie />
</div>

<style>
  .fhn-pie {
    margin-top: 2rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
</style>
