---
// Hero de la portada (reemplaza al de Starlight): el mismo frontmatter `hero`, pero los enlaces de los botones
// llevan la base del sitio (`/empezar/…` → `/factura-hn/empezar/…`), igual que los del contenido.
import { LinkButton } from '@astrojs/starlight/components';
const PAGE_TITLE_ID = '_top'; // el id que Starlight da al título de la página
import { conBase } from '../plugins/rehype-base.mjs';
import { BASE } from '../../sitio.config.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="portada">
  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <p class="lema" set:html={tagline} />}
  {actions.length > 0 && (
    <div class="acciones">
      {actions.map(({ text, link, variant, attrs }) => (
        <LinkButton href={conBase(link, BASE)} variant={variant} {...attrs}>
          {text}
        </LinkButton>
      ))}
    </div>
  )}
</div>

<style>
  .portada {
    padding-block: clamp(2rem, 6vw, 4.5rem) 1rem;
    max-width: 46rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lema {
    margin-top: 1rem;
    font-size: var(--sl-text-xl);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }
</style>
