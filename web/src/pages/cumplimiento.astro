---
// Cumplimiento: la página de confianza. Resume la matriz de /referencia/cumplimiento/ (la misma fuente, leída al
// construir) y dice qué falta. El texto fijo sale de src/md/cumplimiento.md, que es también su versión para IA.
import Sitio from '../layouts/Sitio.astro';
import { Content } from '../md/cumplimiento.md';
import { conBase } from '../datos/navegacion';
import { matriz } from '../datos/proyecto';

// Porcentajes como en el resto del texto: «15 %», con espacio fino que no se parte.
const pct = (n: number, de: number) => `${(Math.round((n / de) * 1000) / 10).toLocaleString('es-HN')} %`;
/** «42 cubiertos», «1 parcial», «10 no aplican». */
const PLURALES: Record<string, [string, string]> = {
  cubierto: ['cubierto', 'cubiertos'],
  parcial: ['parcial', 'parciales'],
  ausente: ['ausente', 'ausentes'],
  documental: ['documental', 'documentales'],
  'no-aplica': ['no aplica', 'no aplican'],
};
const estado = (clase: string, texto: string, n: number) => PLURALES[clase]?.[n === 1 ? 0 : 1] ?? texto.toLowerCase();
const visibles = matriz.porEstado.filter((e) => e.cuenta > 0);
---

<Sitio
	titulo="Cumplimiento"
	descripcion="Cómo factura-hn cumple el Reglamento del Régimen de Facturación (Acuerdo 481-2017) y la Ley del ISV: cada requisito con su artículo, su estado y la prueba que lo verifica."
	ruta="/cumplimiento/"
>
	<header class="pagina-cabeza">
		<div class="contenedor">
			<p class="antetitulo">Cumplimiento</p>
			<h1>Cada regla, con su artículo y su prueba.</h1>
			<p class="entrada">
				{matriz.cubiertos} de {matriz.total} requisitos del Reglamento y de la Ley del ISV están cubiertos y probados. Los
				demás están dichos, uno por uno, con su estado.
			</p>
			<div class="botones acciones">
				<a class="boton boton-primario" href={conBase('/referencia/cumplimiento/')}>Ver la matriz completa</a>
				<a class="boton boton-secundario" href={conBase('/produccion/estado-legal/')}>Estado legal</a>
			</div>
		</div>
	</header>

	<section class="contenedor resumen" aria-labelledby="resumen-titulo">
		<h2 id="resumen-titulo" class="sr-only">Resumen de la matriz</h2>
		<div class="barra" role="img" aria-label={visibles.map((e) => `${e.cuenta} ${estado(e.clase, e.texto, e.cuenta)}`).join(', ')}>
			{visibles.map((e) => <span class={`tramo ${e.clase}`} style={`flex-grow: ${e.cuenta}`} />)}
		</div>
		<ul class="leyenda">
			{
				visibles.map((e) => (
					<li>
						<span class={`punto ${e.clase}`} aria-hidden="true" />
						<strong>{e.cuenta}</strong> {estado(e.clase, e.texto, e.cuenta)}
						<span class="pct">{pct(e.cuenta, matriz.total)}</span>
					</li>
				))
			}
		</ul>
		<div class="rejilla rejilla-2 secciones">
			{
				matriz.secciones.map((s) => (
					<div class="tarjeta">
						<h3>{s.titulo}</h3>
						<p>
							<strong>{s.cubiertos}</strong> de {s.total} requisitos cubiertos y probados
							{s.parciales > 0 && <>, {s.parciales} en parte</>}.
						</p>
					</div>
				))
			}
		</div>
		<p class="nota">
			{matriz.pruebas} pruebas enlazadas desde la matriz, cada una en su línea de GitHub.
		</p>
	</section>

	<div class="contenedor">
		<div class="prosa contenedor-texto cuerpo">
			<Content />
		</div>
	</div>
</Sitio>

<style>
	.acciones {
		margin-top: 2rem;
	}
	.resumen {
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
	}
	.barra {
		display: flex;
		gap: 3px;
		height: 0.75rem;
		border-radius: 999px;
		overflow: hidden;
	}
	.tramo {
		flex-basis: 0;
		min-width: 4px;
	}
	.cubierto {
		background: var(--fhn-verde);
	}
	.parcial {
		background: var(--fhn-naranja);
	}
	.ausente {
		background: var(--fhn-rojo);
	}
	.documental {
		background: var(--fhn-morado);
	}
	.no-aplica {
		background: var(--fhn-gris-4);
	}
	.leyenda {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		margin: 1.25rem 0 2.5rem;
		color: var(--fhn-gris-2);
		font-size: 0.9375rem;
	}
	.leyenda li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.leyenda strong {
		color: var(--fhn-texto);
		font-variant-numeric: tabular-nums;
	}
	.punto {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
	}
	.pct {
		color: var(--fhn-gris-3);
		font-variant-numeric: tabular-nums;
	}
	.secciones strong {
		color: var(--fhn-texto);
	}
	.nota {
		margin: 1.25rem 0 0;
		color: var(--fhn-gris-3);
		font-size: 0.9375rem;
	}
	.cuerpo {
		padding-block: clamp(2rem, 5vw, 3rem) clamp(4rem, 9vw, 6rem);
	}
</style>
