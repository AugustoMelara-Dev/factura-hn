---
// Portada: qué es factura-hn en diez segundos, sus cuatro formas de uso, un ejemplo de código y por qué confiar.
// HTML y CSS estáticos: sin JavaScript propio. Su versión para IA es src/md/portada.md (/index.md).
import { Code } from 'astro:components';
import Sitio from '../layouts/Sitio.astro';
import { conBase } from '../datos/navegacion';
import { PRIMEROS, PRIMERA_FACTURA } from '../datos/comandos.mjs';
import { matriz, version } from '../datos/proyecto';
import { REPO } from '../../sitio.config.mjs';
import { API_DEMO, PRUEBA } from '../datos/demo';
import { EJEMPLO_PORTADA, temasCodigo } from '../datos/ejemplo.mjs';

const temas = await temasCodigo();

const productos = [
  {
    nombre: 'SDK de TypeScript',
    ruta: '/guias/sdk/',
    texto: 'Emite dentro de tu sistema, sobre tu base: PostgreSQL, SQLite o la tuya. Numeración, ISV y bitácora en la misma transacción.',
    comando: PRIMEROS.sdk,
  },
  {
    nombre: 'CLI',
    ruta: '/guias/cli/',
    texto: 'Una factura de prueba en la consola en un minuto, y un proyecto inicial con emitir.mjs y emisor.json.',
    comando: PRIMEROS.cli,
  },
  {
    nombre: 'API REST',
    ruta: '/guias/api/',
    texto: 'Para cualquier lenguaje o varias cajas: OpenAPI 3.1, llaves por punto de emisión, idempotencia, PDF y webhooks.',
    comando: PRIMEROS.api,
  },
  {
    nombre: 'Servidor MCP',
    ruta: '/guias/mcp/',
    texto: 'Un asistente de IA emite, consulta y anula con las mismas reglas. Local por stdio o remoto con una URL.',
    comando: PRIMEROS.mcp,
  },
];

const garantias = [
  {
    titulo: 'Numeración atómica y sin huecos',
    texto: 'Cada número se reserva en la misma transacción que guarda el documento. Nunca se borra ni se reutiliza.',
  },
  {
    titulo: 'Dinero exacto',
    texto: 'Sin punto flotante. El ISV sigue el redondeo del Art. 9 de la Ley del ISV, con tarifas de 15 % y 18 %.',
  },
  {
    titulo: 'Documentos inmutables',
    texto: 'Lo emitido no se edita: se anula (Art. 41) o se corrige con una nota de crédito o de débito.',
  },
  {
    titulo: 'Bitácora de auditoría',
    texto: 'Quién emitió, anuló o registró un CAI, y cuándo (Art. 53 num. 2). Errores en español que dicen qué hacer.',
  },
];
---

<Sitio
	titulo="factura-hn: facturación para Honduras, de código abierto"
	descripcion="Facturación según el Reglamento del Régimen de Facturación de Honduras (Acuerdo 481-2017): SDK de TypeScript, CLI, API REST y servidor MCP de código abierto, con cada regla que implementa citada y probada. Proyecto independiente, no afiliado al SAR."
	ruta="/"
>
	<section class="heroe">
		<div class="contenedor heroe-rejilla">
			<div class="heroe-texto">
				<a class="etiqueta etiqueta-punto" href={conBase('/ayuda/cambios/')}>Versión {version} · código abierto, MIT</a>
				<h1>Facturación para Honduras, con cada regla que implementa citada y probada.</h1>
				<p class="heroe-entrada">
					factura-hn emite facturas, notas de crédito y notas de débito según el Reglamento del Régimen de Facturación del
					SAR (Acuerdo 481-2017). Úsalo como SDK, desde la línea de comandos, como API REST o desde tu asistente de IA
					con MCP.
				</p>
				<div class="botones">
					<a class="boton boton-primario" href={conBase(PRUEBA.ruta)}>{PRUEBA.texto}</a>
					<a class="boton boton-secundario" href={conBase('/empezar/primera-factura/')}>Leer la documentación</a>
				</div>
				<p class="heroe-nota">
					<code class="comando">{PRIMEROS.sdk}</code>
					<span>Sin dependencias · TypeScript · Node 20 o más reciente</span>
				</p>
			</div>
			<div class="heroe-codigo">
				<div class="codigo">
					<div class="codigo-barra"><span>emitir.ts</span><span>factura-hn</span></div>
					<Code code={EJEMPLO_PORTADA} lang="ts" themes={temas} defaultColor={false} />
				</div>
			</div>
		</div>
	</section>

	<section class="seccion" id="productos">
		<div class="contenedor">
			<div class="cabeza-seccion">
				<p class="antetitulo">Producto</p>
				<h2 class="titulo-seccion">Las mismas reglas fiscales, cuatro formas de usarlas.</h2>
				<p class="entrada">
					La API y el MCP llaman por dentro al mismo SDK. Elige según quién emite y dónde se guardan los documentos;
					todos empiezan en modo de prueba, con un CAI ficticio.
				</p>
			</div>
			<div class="rejilla rejilla-2 productos">
				{
					productos.map((p) => (
						<a class="tarjeta" href={conBase(p.ruta)}>
							<h3>{p.nombre}</h3>
							<p>{p.texto}</p>
							<div class="tarjeta-pie">
								<code class="comando">{p.comando.split(' ').map((palabra, i) => (i ? [' ', <span class="palabra">{palabra}</span>] : <span class="palabra">{palabra}</span>))}</code>
							</div>
							<span class="tarjeta-enlace flecha">Ver la guía</span>
						</a>
					))
				}
			</div>
			<p class="productos-mas">
				¿No sabes cuál? <a href={conBase('/empezar/elegir-camino/')}>Compara los caminos</a>, o mira las guías{' '}
				<a href={conBase('/documentos/')}>por tipo de documento</a> y <a href={conBase('/negocios/')}>por tipo de negocio</a>.
			</p>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor pasos-rejilla">
			<div>
				<p class="antetitulo">En cinco minutos</p>
				<h2 class="titulo-seccion">Tu primera factura de prueba, en tres comandos.</h2>
				<p class="entrada">
					En una carpeta nueva o en tu proyecto. Verás el ticket en la consola y quedará <code>factura.html</code> con la
					leyenda «DOCUMENTO DE PRUEBA — SIN VALOR FISCAL».
				</p>
				<div class="botones pasos-botones">
					<a class="boton boton-secundario" href={conBase('/empezar/primera-factura/')}>Tu primera factura</a>
					<a class="boton boton-secundario" href={conBase('/empezar/playground/')}>Probar en el navegador</a>
				</div>
			</div>
			<div class="codigo">
				<div class="codigo-barra"><span>Terminal</span><span>bash</span></div>
				<pre><code>{PRIMERA_FACTURA.join('\n')}</code></pre>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<div class="cabeza-seccion">
				<p class="antetitulo">Lo que resuelve</p>
				<h2 class="titulo-seccion">Lo difícil de facturar, resuelto una vez y probado.</h2>
			</div>
			<div class="rejilla rejilla-2 garantias">
				{
					garantias.map((g) => (
						<div class="garantia">
							<h3>{g.titulo}</h3>
							<p>{g.texto}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion confianza">
		<div class="contenedor">
			<div class="cabeza-seccion">
				<p class="antetitulo">Confianza</p>
				<h2 class="titulo-seccion">Abierto, verificable y sin letra pequeña.</h2>
				<p class="entrada">
					Cada requisito del Reglamento tiene su artículo y la prueba que lo verifica. Si una regla cubierta pierde su
					prueba, el sitio no se construye.
				</p>
			</div>
			<dl class="cifras">
				<div>
					<dt>requisitos cubiertos y probados</dt>
					<dd>{matriz.cubiertos}<span> de {matriz.total}</span></dd>
				</div>
				<div>
					<dt>pruebas enlazadas en la matriz</dt>
					<dd>{matriz.pruebas}</dd>
				</div>
				<div>
					<dt>licencia, sin planes de pago</dt>
					<dd>MIT</dd>
				</div>
			</dl>
			<div class="rejilla rejilla-3">
				<a class="tarjeta" href={conBase('/cumplimiento/')}>
					<h3>Matriz de cumplimiento</h3>
					<p>Requisito, artículo, estado y la prueba en GitHub. Lo que falta también está dicho.</p>
					<span class="tarjeta-enlace flecha">Ver el cumplimiento</span>
				</a>
				<a class="tarjeta" href={conBase('/produccion/estado-legal/')}>
					<h3>Lectura del Reglamento</h3>
					<p>Algunos puntos no son literales. factura-hn declara la lectura que aplica en cada caso.</p>
					<span class="tarjeta-enlace flecha">Ver el estado legal</span>
				</a>
				<a class="tarjeta" href={REPO}>
					<h3>Código abierto</h3>
					<p>Todo el código, las pruebas y la documentación, con licencia MIT. Revísalo, úsalo y contribuye.</p>
					<span class="tarjeta-enlace flecha">Ver en GitHub</span>
				</a>
			</div>
			<p class="nota-version">
				Versión <code>{version}</code>. Mientras sea 0.x puede haber cambios incompatibles entre versiones menores: ver los{' '}
				<a href={conBase('/ayuda/cambios/')}>cambios por versión</a>.
			</p>
			<p class="aviso-independiente confianza-aviso">
				<strong>Proyecto independiente, no afiliado al SAR.</strong> factura-hn no es asesoría fiscal ni un sistema autorizado
				por el SAR. Quien emite sigue siendo responsable de cumplir el Reglamento; revisa la configuración con tu contador.
			</p>
		</div>
	</section>

	<section class="seccion cierre">
		<div class="contenedor cierre-caja">
			<h2 class="titulo-seccion">Pruébalo sin instalar nada.</h2>
			{
				API_DEMO ? (
					<p class="entrada">
						Crea un entorno de prueba con tu propia llave y una URL del MCP para tu asistente. Dura 24 horas y no tiene
						datos reales.
					</p>
				) : (
					<p class="entrada">
						El playground corre el SDK en tu navegador: emite una factura de prueba y mira el ticket, sin cuenta y sin
						instalar nada.
					</p>
				)
			}
			<div class="botones">
				<a class="boton boton-primario" href={conBase(PRUEBA.ruta)}>{PRUEBA.texto}</a>
				<a class="boton boton-secundario" href={conBase('/precios/')}>Ver precios</a>
			</div>
		</div>
	</section>
</Sitio>

<style>
	.heroe {
		padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 9vw, 6.5rem);
	}
	.heroe-rejilla {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}
	.heroe h1 {
		margin: 1.25rem 0 0;
		font-size: clamp(2.375rem, 5.6vw, 4rem);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.04em;
		text-wrap: balance;
		color: var(--fhn-texto);
	}
	.heroe-entrada {
		margin: 1.25rem 0 2rem;
		max-width: 36rem;
		font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
		line-height: 1.6;
		color: var(--fhn-gris-3);
		text-wrap: pretty;
	}
	.heroe-nota {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin: 1.75rem 0 0;
		color: var(--fhn-gris-3);
		font-size: 0.875rem;
	}
	.heroe-codigo {
		min-width: 0;
	}
	@media (min-width: 64rem) {
		.heroe-rejilla {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		}
	}

	.tarjeta-enlace {
		color: var(--fhn-acento-texto);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.productos-mas {
		margin: 2rem 0 0;
		color: var(--fhn-gris-3);
	}

	.pasos-rejilla {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	.pasos-botones {
		margin-top: 2rem;
	}
	@media (min-width: 64rem) {
		.pasos-rejilla {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 4rem;
		}
	}

	.garantias {
		gap: 0;
		border-top: 1px solid var(--fhn-borde);
	}
	.garantia {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--fhn-borde);
	}
	.garantia h3 {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--fhn-texto);
	}
	.garantia p {
		margin: 0.5rem 0 0;
		max-width: 30rem;
		color: var(--fhn-gris-3);
	}
	@media (min-width: 40rem) {
		.garantias {
			column-gap: 3rem;
		}
	}

	.cifras {
		display: grid;
		gap: 1px;
		margin: 0 0 1rem;
		border: 1px solid var(--fhn-borde);
		border-radius: 12px;
		background: var(--fhn-borde);
		overflow: hidden;
	}
	.cifras > div {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.25rem;
		padding: 1.5rem;
		background: var(--fhn-fondo);
	}
	.cifras dt {
		color: var(--fhn-gris-3);
		font-size: 0.9375rem;
	}
	.cifras dd {
		margin: 0;
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		color: var(--fhn-texto);
	}
	.cifras dd span {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--fhn-gris-3);
	}
	@media (min-width: 48rem) {
		.cifras {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.nota-version {
		margin: 2rem 0 0;
		color: var(--fhn-gris-3);
		font-size: 0.9375rem;
	}
	.nota-version code {
		font-size: 0.875em;
		color: var(--fhn-texto);
	}
	.confianza-aviso {
		margin: 1rem 0 0;
	}

	.cierre-caja {
		text-align: center;
	}
	.cierre-caja .titulo-seccion,
	.cierre-caja .entrada {
		margin-inline: auto;
	}
	.cierre-caja .botones {
		justify-content: center;
		margin-top: 2rem;
	}
</style>
