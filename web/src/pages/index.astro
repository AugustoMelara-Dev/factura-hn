---
// Portada: qué es factura-hn, cómo se integra, cómo se conecta a un asistente de IA, por qué es confiable y dónde
// encontrar a la comunidad. HTML y CSS estáticos; el único JavaScript es el de los botones «Copiar».
// Su versión para IA es src/md/portada.md (/index.md): si cambias el texto aquí, cámbialo allá.
import Sitio from '../layouts/Sitio.astro';
import Codigo from '../components/producto/Codigo.astro';
import { conBase, DISCUSIONES, DOCUMENTACION } from '../datos/navegacion';
import { API_DOCKER, PRIMEROS, PRIMERA_FACTURA } from '../datos/comandos.mjs';
import { EJEMPLO_PORTADA } from '../datos/ejemplo.mjs';
import { REPO } from '../../sitio.config.mjs';

const formas = [
  {
    nombre: 'SDK',
    texto: 'Emite desde tu sistema en Node, sobre PostgreSQL, SQLite o tu propia base.',
    codigo: PRIMERA_FACTURA.join('\n'),
    ruta: '/guias/sdk/',
  },
  {
    nombre: 'CLI',
    texto: 'Una factura de prueba en la consola, sin escribir código.',
    codigo: PRIMEROS.cli,
    ruta: '/guias/cli/',
  },
  {
    nombre: 'API REST',
    texto: 'Para cualquier lenguaje o varias cajas, con Docker y PostgreSQL.',
    codigo: API_DOCKER.join('\n'),
    ruta: '/guias/api/',
  },
  {
    nombre: 'MCP',
    texto: 'Un asistente de IA emite, consulta y anula con las mismas reglas.',
    codigo: PRIMEROS.mcp,
    ruta: '/guias/mcp/',
  },
];

const ISSUES = `${REPO}/issues/new/choose`;
const SEGURIDAD = `${REPO}/security/advisories/new`;
---

<Sitio
	titulo="factura-hn: facturación para Honduras, de código abierto"
	descripcion="Emite facturas y notas de crédito y débito según el Reglamento de Facturación del SAR desde tu código: SDK de TypeScript, CLI, API REST y servidor MCP. Gratis y de código abierto. Proyecto independiente, no afiliado al SAR."
	ruta="/"
>
	<section class="heroe" aria-labelledby="titulo-heroe">
		<div class="contenedor heroe-caja">
			<h1 id="titulo-heroe">Facturación para Honduras, desde tu código.</h1>
			<p class="heroe-entrada">
				Emite facturas y notas de crédito y débito que cumplen el Reglamento del SAR. Empieza en modo de prueba, en un
				minuto.
			</p>
			<div class="heroe-codigo">
				<Codigo codigo={EJEMPLO_PORTADA} lang="js" titulo="emitir.mjs" etiqueta="Copiar el ejemplo" />
			</div>
			<div class="botones">
				<a class="boton boton-primario" href={conBase(DOCUMENTACION)}>Empezar</a>
				<a class="boton boton-secundario" href={REPO} rel="noopener">GitHub</a>
			</div>
		</div>
	</section>

	<section class="seccion" aria-labelledby="que-es">
		<div class="contenedor">
			<p class="antetitulo">Qué es</p>
			<h2 class="titulo-seccion" id="que-es">Lo difícil de facturar, resuelto.</h2>
			<p class="entrada">
				factura-hn es una librería de TypeScript, sin dependencias, que lleva la numeración con CAI y rangos, calcula el
				ISV sin errores de redondeo e imprime en hoja carta o ticket. Lo emitido no se edita: se anula o se corrige con
				una nota. Es gratis y de código abierto.
			</p>
		</div>
	</section>

	<section class="seccion" aria-labelledby="integra">
		<div class="contenedor">
			<p class="antetitulo">Cómo se integra</p>
			<h2 class="titulo-seccion" id="integra">Cuatro formas, las mismas reglas.</h2>
			<div class="rejilla rejilla-2">
				{
					formas.map((f) => (
						<article class="forma">
							<h3>{f.nombre}</h3>
							<p>{f.texto}</p>
							<Codigo codigo={f.codigo} lang="bash" titulo="Terminal" etiqueta={`Copiar los comandos de ${f.nombre}`} />
							<a class="enlace flecha" href={conBase(f.ruta)}>
								Guía de {f.nombre}
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion" aria-labelledby="ia">
		<div class="contenedor">
			<p class="antetitulo">Conéctalo a tu IA</p>
			<h2 class="titulo-seccion" id="ia">Factura conversando con tu asistente.</h2>
			<p class="entrada">
				El servidor MCP de factura-hn le da a tu asistente las herramientas para emitir, consultar y anular. Este comando
				crea una base de prueba e imprime el bloque listo para pegar:
			</p>
			<div class="comando-ia">
				<Codigo codigo={PRIMEROS.mcp} lang="bash" titulo="Terminal" etiqueta="Copiar el comando del MCP" />
			</div>
			<div class="rejilla rejilla-3">
				<article class="forma">
					<h3>Claude</h3>
					<p>
						Claude Desktop: Settings › Developer › Edit Config abre <code>claude_desktop_config.json</code>. Claude Code:
						<code>.mcp.json</code> en la raíz del proyecto, o <code>claude mcp add-json</code>.
					</p>
				</article>
				<article class="forma">
					<h3>Cursor</h3>
					<p>
						Pégalo en <code>~/.cursor/mcp.json</code> (todos tus proyectos) o en <code>.cursor/mcp.json</code> (solo
						uno) y reinicia Cursor.
					</p>
				</article>
				<article class="forma">
					<h3>ChatGPT</h3>
					<p>
						Levanta la API REST y el MCP por HTTP en tu servidor, con HTTPS. Crea su URL con
						<code>factura-hn-api llave crear … --mcp</code> y agrégala en ChatGPT como conector MCP, sin autenticación.
					</p>
					<a class="enlace flecha" href={conBase('/ia/mcp/#chatgpt')}>Pasos para ChatGPT</a>
				</article>
			</div>
			<p class="mas">Luego pide: «emite una factura de prueba». <a class="enlace flecha" href={conBase('/guias/mcp/')}>Guía del servidor MCP</a></p>
		</div>
	</section>

	<section class="seccion" aria-labelledby="confianza">
		<div class="contenedor">
			<p class="antetitulo">Por qué es confiable</p>
			<h2 class="titulo-confianza" id="confianza">Cumple el Reglamento de Facturación del SAR y cada regla está probada.</h2>
			<p class="mas"><a class="enlace flecha" href={conBase('/referencia/cumplimiento/')}>Ver cada regla con su prueba</a></p>
		</div>
	</section>

	<section class="seccion" aria-labelledby="comunidad">
		<div class="contenedor">
			<p class="antetitulo">Comunidad</p>
			<h2 class="titulo-seccion" id="comunidad">Hecho en abierto.</h2>
			<p class="entrada">Pregunta, propón mejoras y contribuye con código, pruebas o documentación.</p>
			<ul class="rejilla rejilla-3 lista-tarjetas">
				<li>
					<a class="tarjeta" href={REPO} rel="noopener">
						<span class="tarjeta-titulo">GitHub</span>
						<span>El código, las pruebas y la documentación, con licencia MIT.</span>
					</a>
				</li>
				<li>
					<a class="tarjeta" href={DISCUSIONES} rel="noopener">
						<span class="tarjeta-titulo">Discussions</span>
						<span>Preguntas, ideas y lo que estás construyendo.</span>
					</a>
				</li>
				<li>
					<a class="tarjeta" href={conBase('/ayuda/contribuir/')}>
						<span class="tarjeta-titulo">Cómo contribuir</span>
						<span>Prepara el proyecto, corre las pruebas y abre tu pull request.</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<section class="seccion" aria-labelledby="contacto">
		<div class="contenedor">
			<p class="antetitulo">Contacto</p>
			<h2 class="titulo-seccion" id="contacto">Escríbenos en GitHub.</h2>
			<dl class="contacto">
				<div>
					<dt>Preguntas e ideas</dt>
					<dd><a class="enlace flecha" href={DISCUSIONES} rel="noopener">Abre una discusión</a></dd>
				</div>
				<div>
					<dt>Un error, o una regla fiscal que crees que está mal</dt>
					<dd><a class="enlace flecha" href={ISSUES} rel="noopener">Abre un issue</a></dd>
				</div>
				<div>
					<dt>Una vulnerabilidad</dt>
					<dd><a class="enlace flecha" href={SEGURIDAD} rel="noopener">Repórtala en privado</a>, nunca en un issue público</dd>
				</div>
			</dl>
			<p class="nota">No incluyas datos reales de contribuyentes en ningún reporte.</p>
		</div>
	</section>
</Sitio>
