---
// Portada: qué es factura-hn, una factura de prueba emitida aquí mismo, por qué es confiable, cómo se integra, cómo
// se conecta a un asistente de IA y dónde encontrar a la comunidad.
// JavaScript: el script en línea de los botones «Copiar» y la demo (components/producto/Demo.astro), que empaqueta
// el SDK del repositorio. El ticket de «Qué es» lo genera el mismo SDK al construir.
// Su versión para IA es src/md/portada.md (/index.md): si cambias el texto aquí, cámbialo allá.
import Sitio from '../layouts/Sitio.astro';
import Codigo from '../components/producto/Codigo.astro';
import Demo from '../components/producto/Demo.astro';
import Ticket from '../components/producto/Ticket.astro';
import { conBase, DISCUSIONES, DOCUMENTACION } from '../datos/navegacion';
import { API_DOCKER, INSTALAR, PRIMEROS, PRIMERA_FACTURA } from '../datos/comandos.mjs';
import { EJEMPLO_PORTADA } from '../datos/ejemplo.mjs';
import { REPO } from '../../sitio.config.mjs';

const formas = [
  {
    nombre: 'SDK',
    texto: 'Emite desde tu sistema en Node, sobre PostgreSQL, SQLite o tu propia base.',
    codigo: PRIMERA_FACTURA.join('\n'),
    ruta: '/guias/sdk/',
  },
  {
    nombre: 'CLI',
    texto: 'Una factura de prueba en la consola, sin escribir código.',
    codigo: PRIMEROS.cli,
    ruta: '/guias/cli/',
  },
  {
    nombre: 'API REST',
    texto: 'Para cualquier lenguaje o varias cajas, con Docker y PostgreSQL.',
    codigo: API_DOCKER.join('\n'),
    ruta: '/guias/api/',
  },
  {
    nombre: 'MCP',
    texto: 'Un asistente de IA emite, consulta y anula con las mismas reglas.',
    codigo: PRIMEROS.mcp,
    ruta: '/guias/mcp/',
  },
];

/** Los asistentes: el nombre y el enlace a sus pasos en la guía del MCP. */
const asistentes = [
  { nombre: 'Claude', detalle: 'Claude Desktop y Claude Code', ruta: '/ia/mcp/#empieza-en-3-pasos' },
  { nombre: 'Cursor', detalle: 'En todos tus proyectos o en uno', ruta: '/ia/mcp/#empieza-en-3-pasos' },
  { nombre: 'ChatGPT', detalle: 'Por URL, con tu API en tu servidor', ruta: '/ia/mcp/#chatgpt' },
];

const confianza = [
  { titulo: 'Numeración sin huecos ni repetidos', texto: 'Cada número se reserva en la misma transacción que guarda el documento.' },
  { titulo: 'ISV exacto al centavo', texto: 'Sin punto flotante, con el redondeo del Art. 9 de la Ley del ISV.' },
  { titulo: 'Lo emitido no se edita', texto: 'Se anula (Art. 41) o se corrige con una nota de crédito o de débito.' },
];

const ISSUES = `${REPO}/issues/new/choose`;
const SEGURIDAD = `${REPO}/security/advisories/new`;
---

<Sitio
	titulo="factura-hn: facturación para Honduras, de código abierto"
	descripcion="Emite facturas y notas de crédito y débito según el Reglamento de Facturación del SAR desde tu código: SDK de TypeScript, CLI, API REST y servidor MCP. Gratis y de código abierto. Proyecto independiente, no afiliado al SAR."
	ruta="/"
>
	<section class="heroe" aria-labelledby="titulo-heroe">
		<div class="contenedor heroe-caja">
			<h1 id="titulo-heroe">Facturación para Honduras, desde tu código.</h1>
			<p class="heroe-entrada">
				Emite facturas y notas de crédito y débito que cumplen el Reglamento del SAR. Tu primera factura de prueba, en
				5&nbsp;minutos.
			</p>
			<div class="botones">
				<a class="boton boton-primario" href={conBase(DOCUMENTACION)}>Empezar</a>
				<a class="boton boton-secundario" href="#probar">Pruébalo aquí</a>
			</div>
			<div class="heroe-instalar">
				<Codigo codigo={INSTALAR} lang="bash" titulo="Terminal" etiqueta="Copiar el comando de instalación" />
			</div>
			<figure class="video">
				<video
					controls
					muted
					playsinline
					preload="metadata"
					width="1920"
					height="1080"
					poster={conBase('/video/poster.jpg')}
					aria-label="Video de factura-hn: de npm install a una factura de prueba impresa"
				>
					<source src={conBase('/video/factura-hn-lanzamiento.mp4')} type="video/mp4" />
				</video>
			</figure>
		</div>
	</section>

	<section class="seccion" aria-labelledby="que-es">
		<div class="contenedor dos">
			<div class="dos-texto">
				<p class="antetitulo">Qué es</p>
				<h2 class="titulo-seccion" id="que-es">Lo difícil de facturar, resuelto.</h2>
				<p class="entrada">
					factura-hn es una librería de TypeScript, sin dependencias, que lleva la numeración con CAI y rangos, calcula el
					ISV sin errores de redondeo e imprime en hoja carta o ticket. Es gratis y de código abierto.
				</p>
				<div class="bloque">
					<Codigo codigo={EJEMPLO_PORTADA} lang="js" titulo="emitir.mjs" etiqueta="Copiar el ejemplo" />
				</div>
			</div>
			<Ticket />
		</div>
	</section>

	<section class="seccion" id="probar" aria-labelledby="titulo-probar">
		<div class="contenedor">
			<p class="antetitulo">Pruébalo aquí</p>
			<h2 class="titulo-seccion" id="titulo-probar">Emite una factura de prueba sin instalar nada.</h2>
			<p class="entrada">El SDK corre en esta página con un emisor y un CAI ficticios. Cada emisión toma el número siguiente.</p>
			<Demo />
		</div>
	</section>

	<section class="seccion" aria-labelledby="confianza">
		<div class="contenedor dos">
			<div class="dos-texto">
				<p class="antetitulo">Por qué es confiable</p>
				<h2 class="titulo-seccion" id="confianza">Cumple el Reglamento de Facturación del SAR y cada regla está probada.</h2>
				<p class="mas"><a class="enlace flecha" href={conBase('/referencia/cumplimiento/')}>Ver cada regla con su prueba</a></p>
			</div>
			<ul class="puntos">
				{
					confianza.map((c) => (
						<li>
							<strong>{c.titulo}</strong>
							<span>{c.texto}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="seccion" aria-labelledby="integra">
		<div class="contenedor">
			<p class="antetitulo">Cómo se integra</p>
			<h2 class="titulo-seccion" id="integra">Cuatro formas, las mismas reglas.</h2>
			<div class="rejilla rejilla-2">
				{
					formas.map((f) => (
						<article class="forma">
							<h3>{f.nombre}</h3>
							<p>{f.texto}</p>
							<Codigo codigo={f.codigo} lang="bash" titulo="Terminal" etiqueta={`Copiar los comandos de ${f.nombre}`} />
							<a class="enlace flecha" href={conBase(f.ruta)}>
								Guía de {f.nombre}
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion" aria-labelledby="ia">
		<div class="contenedor dos">
			<div class="dos-texto">
				<p class="antetitulo">Conéctalo a tu IA</p>
				<h2 class="titulo-seccion" id="ia">Factura conversando con tu asistente.</h2>
				<p class="entrada">
					El servidor MCP le da a tu asistente las herramientas para emitir, consultar y anular. Este comando crea una base
					de prueba e imprime el bloque listo para pegar. Luego pide: «emite una factura de prueba».
				</p>
				<div class="bloque">
					<Codigo codigo={PRIMEROS.mcp} lang="bash" titulo="Terminal" etiqueta="Copiar el comando del MCP" />
				</div>
			</div>
			<ul class="asistentes">
				{
					asistentes.map((a) => (
						<li>
							<a class="asistente" href={conBase(a.ruta)}>
								<span class="asistente-icono" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4A2.5 2.5 0 0 1 4 13.5z" />
										<path d="M8.5 9.5h7" />
									</svg>
								</span>
								<span class="asistente-texto">
									<span class="asistente-nombre">{a.nombre}</span>
									<span class="asistente-detalle">{a.detalle}</span>
								</span>
								<span class="asistente-ver">Ver cómo →</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="seccion" aria-labelledby="comunidad">
		<div class="contenedor dos">
			<div class="dos-texto">
				<p class="antetitulo">Comunidad</p>
				<h2 class="titulo-seccion" id="comunidad">Hecho en abierto.</h2>
				<p class="entrada">Pregunta, propón mejoras y contribuye con código, pruebas o documentación.</p>
			</div>
			<ul class="lista-tarjetas">
				<li>
					<a class="tarjeta" href={REPO} rel="noopener">
						<span class="tarjeta-titulo">GitHub</span>
						<span>El código, las pruebas y la documentación, con licencia MIT.</span>
					</a>
				</li>
				<li>
					<a class="tarjeta" href={DISCUSIONES} rel="noopener">
						<span class="tarjeta-titulo">Discussions</span>
						<span>Preguntas, ideas y lo que estás construyendo.</span>
					</a>
				</li>
				<li>
					<a class="tarjeta" href={conBase('/ayuda/contribuir/')}>
						<span class="tarjeta-titulo">Cómo contribuir</span>
						<span>Prepara el proyecto, corre las pruebas y abre tu pull request.</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<section class="seccion" aria-labelledby="contacto">
		<div class="contenedor dos">
			<div class="dos-texto">
				<p class="antetitulo">Contacto</p>
				<h2 class="titulo-seccion" id="contacto">Escríbenos en GitHub.</h2>
				<p class="entrada">No incluyas datos reales de contribuyentes en ningún reporte.</p>
			</div>
			<dl class="contacto">
				<div>
					<dt>Preguntas e ideas</dt>
					<dd><a class="enlace flecha" href={DISCUSIONES} rel="noopener">Abre una discusión</a></dd>
				</div>
				<div>
					<dt>Un error, o una regla fiscal que crees que está mal</dt>
					<dd><a class="enlace flecha" href={ISSUES} rel="noopener">Abre un issue</a></dd>
				</div>
				<div>
					<dt>Una vulnerabilidad</dt>
					<dd><a class="enlace flecha" href={SEGURIDAD} rel="noopener">Repórtala en privado</a>, nunca en un issue público</dd>
				</div>
			</dl>
		</div>
	</section>
</Sitio>
