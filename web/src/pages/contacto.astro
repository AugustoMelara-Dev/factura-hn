---
// Contacto: issues y discusiones de GitHub y el reporte privado de vulnerabilidades. Sin formulario: nada va a terceros.
// El texto sale de src/md/contacto.md, la misma fuente de su versión para IA (/contacto.md).
import Sitio from '../layouts/Sitio.astro';
import { Content } from '../md/contacto.md';
---

<Sitio titulo="Contacto" descripcion="Cómo contactar al proyecto factura-hn: issues y discusiones en GitHub, y el reporte privado de vulnerabilidades." ruta="/contacto/">
	<header class="pagina-cabeza">
		<div class="contenedor">
			<p class="antetitulo">Contacto</p>
			<h1>Hablemos en GitHub.</h1>
			<p class="entrada">Preguntas, errores, reglas fiscales y vulnerabilidades: cada cosa tiene su lugar en el repositorio.</p>
		</div>
	</header>
	<div class="contenedor">
		<div class="prosa contenedor-texto cuerpo">
			<Content />
		</div>
	</div>
</Sitio>

<style>
	.cuerpo {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 9vw, 6rem);
	}
</style>
