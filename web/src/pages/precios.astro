---
// Precios: todo es gratis y de código abierto (MIT). Sin planes de pago inventados.
// El texto sale de src/md/precios.md, la misma fuente de su versión para IA (/precios.md).
import Sitio from '../layouts/Sitio.astro';
import { Content } from '../md/precios.md';
import { API_DEMO } from '../datos/demo';

const productos = API_DEMO ? 'El SDK, la CLI, la API, el MCP y la demostración pública' : 'El SDK, la CLI, la API y el MCP';
---

<Sitio titulo="Precios" descripcion={`factura-hn es gratis y de código abierto (MIT): SDK, CLI, API para autoalojar y servidor MCP${API_DEMO ? ", más la demostración pública con datos de prueba" : ""}.`} ruta="/precios/">
	<header class="pagina-cabeza">
		<div class="contenedor">
			<p class="antetitulo">Precios</p>
			<h1>Gratis y de código abierto.</h1>
			<p class="entrada">{productos} no cuestan nada. La licencia es MIT.</p>
		</div>
	</header>
	<div class="contenedor">
		<div class="prosa contenedor-texto cuerpo">
			<Content />
		</div>
	</div>
</Sitio>

<style>
	.cuerpo {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 9vw, 6rem);
	}
</style>
