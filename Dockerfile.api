# API de factura-hn. Construcción en dos etapas: la imagen final es Node + un solo archivo, sin node_modules.
# Imagen base fijada por versión y por digest (la misma de Dockerfile.mcp): se actualiza a propósito, no en cada construcción.
FROM node:22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS construccion
WORKDIR /src
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter @factura-hn/api... \
 && pnpm --filter @factura-hn/api build:docker

FROM node:22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a
ENV NODE_ENV=production
WORKDIR /app
COPY --from=construccion /src/packages/api/dist-docker/ ./
# La consola del operador se invoca igual que fuera de Docker: `docker compose exec api factura-hn-api …`
# (`node cli.cjs …` sigue funcionando). FHN_CONSOLA hace que el servidor y la consola la muestren así.
RUN printf '#!/bin/sh\nexec node /app/cli.cjs "$@"\n' > /usr/local/bin/factura-hn-api && chmod 755 /usr/local/bin/factura-hn-api
ENV FHN_CONSOLA="docker compose exec api factura-hn-api"
USER node
EXPOSE 8787
HEALTHCHECK --interval=5s --timeout=3s --retries=20 CMD wget -qO- http://127.0.0.1:8787/salud || exit 1
CMD ["node", "servidor.cjs"]
