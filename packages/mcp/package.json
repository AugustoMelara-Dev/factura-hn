{
  "name": "@factura-hn/mcp",
  "version": "0.3.0",
  "description": "Servidor MCP de factura-hn: emite, consulta y anula documentos SAR Honduras desde un agente de IA, vía la API o el SDK local. Proyecto independiente, no afiliado al SAR.",
  "keywords": [
    "honduras",
    "sar",
    "factura",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "factura-hn-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --target node22",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copiar-docs.mjs packages/mcp LICENSE"
  },
  "dependencies": {
    "@factura-hn/cliente": "workspace:^",
    "@factura-hn/sqlite": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.2",
    "factura-hn": "workspace:^",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@factura-hn/api": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AugustoMelara-Dev/factura-hn.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://augustomelara-dev.github.io/factura-hn/",
  "bugs": {
    "url": "https://github.com/AugustoMelara-Dev/factura-hn/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
