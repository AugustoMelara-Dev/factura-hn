{
  "name": "@factura-hn/pdf",
  "version": "0.2.0",
  "description": "PDF de documentos fiscales de factura-hn (carta y ticket 80 mm), sin navegador.",
  "keywords": [
    "honduras",
    "sar",
    "factura",
    "pdf"
  ],
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "factura-hn": "workspace:^"
  },
  "devDependencies": {
    "factura-hn": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copiar-docs.mjs packages/pdf LICENSE"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factura-hn/factura-hn.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://factura-hn.github.io/factura-hn/",
  "bugs": {
    "url": "https://github.com/factura-hn/factura-hn/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
