{
  "name": "factura-hn",
  "version": "0.2.0",
  "description": "Facturación SAR Honduras (Acuerdo 481-2017): numeración, control de CAI y rangos, cálculo de ISV 15%/18%, montos en letras, validación y render imprimible. Sin dependencias. Lista para usar con agentes de IA.",
  "keywords": [
    "honduras",
    "sar",
    "factura",
    "facturacion",
    "cai",
    "isv",
    "autoimpresor",
    "pos",
    "invoice",
    "lempiras"
  ],
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pruebas": {
      "import": {
        "types": "./dist/pruebas.d.ts",
        "default": "./dist/pruebas.js"
      },
      "require": {
        "types": "./dist/pruebas.d.cts",
        "default": "./dist/pruebas.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "skills",
    "docs",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/pruebas.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copiar-docs.mjs packages/core"
  }
}
