{
  "name": "@factura-hn/cliente",
  "version": "0.2.0",
  "description": "Cliente tipado de la API REST de factura-hn, generado desde su OpenAPI. Funciona en Node, navegador, Deno y edge. Proyecto independiente, no afiliado al SAR.",
  "keywords": [
    "honduras",
    "sar",
    "factura",
    "api",
    "openapi"
  ],
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs/api.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generar": "openapi-typescript ../api/openapi.json -o src/esquema.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copiar-docs.mjs packages/cliente LICENSE AGENTS.md docs/api.md"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@factura-hn/api": "workspace:*",
    "@types/pg": "8.23.1",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AugustoMelara-Dev/factura-hn.git",
    "directory": "packages/cliente"
  },
  "homepage": "https://augustomelara-dev.github.io/factura-hn/",
  "bugs": {
    "url": "https://github.com/AugustoMelara-Dev/factura-hn/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
