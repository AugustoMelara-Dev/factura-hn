{
  "name": "@factura-hn/api",
  "version": "0.3.0",
  "private": true,
  "description": "API REST de factura-hn: alojada multi-tenant o local single-tenant con Docker (Art. 47).",
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "factura-hn-api": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/servidor.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/servidor.ts",
    "test": "vitest run --passWithNoTests",
    "test:owasp": "vitest run test/owasp",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx src/cli.ts openapi openapi.json",
    "build:docker": "tsup --config tsup.docker.config.ts",
    "carga": "tsx carga/emitir.ts"
  },
  "dependencies": {
    "@factura-hn/pdf": "workspace:*",
    "@factura-hn/postgres": "workspace:*",
    "@hono/node-server": "2.1.9",
    "@hono/zod-openapi": "1.6.3",
    "factura-hn": "workspace:*",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "7.12.7",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autocannon": "9.0.0",
    "fast-check": "4.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AugustoMelara-Dev/factura-hn.git",
    "directory": "packages/api"
  }
}
