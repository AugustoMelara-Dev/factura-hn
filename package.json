{
  "name": "factura-hn",
  "version": "0.1.0",
  "description": "Facturación SAR Honduras (Acuerdo 481-2017): numeración, control de CAI y rangos, cálculo de ISV 15%/18%, montos en letras, validación y render imprimible. Sin dependencias. Lista para usar con agentes de IA.",
  "keywords": [
    "honduras",
    "sar",
    "factura",
    "facturacion",
    "cai",
    "isv",
    "autoimpresor",
    "pos",
    "invoice",
    "lempiras"
  ],
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "skills",
    "docs",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "npx tsx examples/basico.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
