{
  "name": "factura-hn-monorepo",
  "private": true,
  "description": "Monorepo de factura-hn: SDK, API REST y servidor MCP para facturación SAR Honduras. Proyecto independiente, no afiliado al SAR.",
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r typecheck",
    "test:pg": "node scripts/test-pg.mjs",
    "mutacion": "pnpm --filter factura-hn mutacion",
    "ci": "pnpm auditar:datos && pnpm build && pnpm typecheck && pnpm test && pnpm test:ejemplos && pnpm test:pg && node scripts/verificar-dist.mjs && pnpm sitio",
    "verificar:dist": "pnpm build && node scripts/verificar-dist.mjs",
    "humo": "pnpm build && node scripts/humo.mjs",
    "example": "pnpm --filter factura-hn build && pnpm --filter ./examples/basico start",
    "test:ejemplos": "pnpm -r --filter \"./examples/*\" test",
    "playground": "pnpm --filter @factura-hn/ejemplo-playground build",
    "pos": "pnpm --filter @factura-hn/ejemplo-pos-offline start",
    "auditar:datos": "node scripts/auditar-datos.mjs",
    "lint:openapi": "redocly lint packages/api/openapi.json",
    "colecciones": "pnpm --filter @factura-hn/colecciones generar",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/verificar-dist.mjs && node scripts/publicar.mjs",
    "sitio": "pnpm playground && pnpm --filter @factura-hn/sitio construir",
    "version": "changeset version && node scripts/fijar-version-mcp.mjs",
    "sitio:ver": "pnpm --filter @factura-hn/sitio preview"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@redocly/cli": "2.82.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AugustoMelara-Dev/factura-hn.git"
  },
  "homepage": "https://augustomelara-dev.github.io/factura-hn/"
}
