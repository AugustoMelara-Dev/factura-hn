{
  "name": "factura-hn-monorepo",
  "private": true,
  "description": "Monorepo de factura-hn: SDK, API REST y servidor MCP para facturación SAR Honduras.",
  "license": "MIT",
  "author": "Augusto Melara (VitoCode Technologies)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "test": "pnpm -r --filter ./packages/* test",
    "typecheck": "pnpm -r typecheck",
    "test:pg": "node scripts/test-pg.mjs",
    "example": "pnpm --filter factura-hn build && pnpm --filter ./examples/basico start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
